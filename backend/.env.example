# AI Assist (AAS) backend configuration.
# Copy this file to .env and fill in the values.
# NOTE: .env is git-ignored on purpose — API keys are never committed for security.
# Get a free Gemini key at https://aistudio.google.com/apikey
APP_ENV=development
AI_PROVIDER=gemini
GEMINI_API_KEY=  # paste your key here
VIDEO_PROVIDER=youtube
DATABASE_URL=
